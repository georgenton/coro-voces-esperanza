# Aplicación
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=America/Guayaquil
DATABASE_URL=postgresql://voces:voces_local@localhost:5432/voces_esperanza
POSTGRES_PASSWORD=replace-with-a-strong-local-or-production-password

# Genere secretos distintos para cada entorno. No copie estos marcadores.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
QR_SIGNING_SECRET=replace-with-an-independent-32-character-secret

# Archivos privados persistentes, siempre fuera de public/.
PRIVATE_UPLOAD_DIR=./var/uploads
MAX_UPLOAD_BYTES=10485760

# Lectura opcional de comprobantes. Sin clave, el modo manual sigue activo.
AI_VISION_PROVIDER=disabled
AI_VISION_BASE_URL=https://api.openai.com/v1
AI_VISION_MODEL=
OPENAI_API_KEY=

# Tareas programadas protegidas.
CRON_SECRET=replace-with-an-independent-secret

# Solo para crear fixtures sintéticos locales con `pnpm db:seed`.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
SEED_SYNTHETIC_DATA=false
